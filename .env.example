# Provider: "perplexity" (default) or "mock" (offline, no key needed)
INSIGHT_PROVIDER=perplexity

# Perplexity API key — get one at https://docs.perplexity.ai
INSIGHT_PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxx

# Sonar model for synthesis modes (answer, recommend, compare, reviews, alternatives)
INSIGHT_PERPLEXITY_SYNTH_MODEL=sonar

# Search context size: low | medium | high  (low = cheapest)
INSIGHT_PERPLEXITY_SEARCH_CONTEXT=low

# Engine
INSIGHT_MAX_RESULTS=20
INSIGHT_PAGE_SIZE=10
INSIGHT_CACHE_ENABLED=true
INSIGHT_CACHE_TTL_SECONDS=300

# Auth — set to false to disable API key requirement
INSIGHT_AUTH_ENABLED=true
INSIGHT_KEYS_FILE=keys.csv

# Safety — comma-separated domains to block when safety=true
INSIGHT_SAFETY_BLOCKLIST=
